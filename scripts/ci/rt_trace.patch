diff --git a/ps2xTest/src/ps2_runtime_guestheap_tests.cpp b/ps2xTest/src/ps2_runtime_guestheap_tests.cpp
new file mode 100644
index 0000000..0582eb7
--- /dev/null
+++ b/ps2xTest/src/ps2_runtime_guestheap_tests.cpp
@@ -0,0 +1,76 @@
+#include "MiniTest.h"
+#include "ps2_runtime.h"
+
+#include <cstdint>
+
+namespace
+{
+    // Synthetic stand-in for a game's SetupHeap(base, size) values (The Warriors uses
+    // 0x715B5C / 0x18DA4A4; the exact numbers are irrelevant to the contract under test).
+    constexpr uint32_t kGameHeapBase = 0x00715B60u;
+    constexpr uint32_t kGameHeapLimit = 0x01FF0000u;
+}
+
+void register_ps2_runtime_guestheap_tests()
+{
+    MiniTest::Case("PS2RuntimeGuestHeap", [](TestCase &tc)
+    {
+        tc.Run("stub scratch allocations stay outside the game's reported heap window", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            runtime.configureGuestHeap(kGameHeapBase, kGameHeapLimit);
+
+            // The reported window must remain the game's values (SetupHeap return value and
+            // EndOfHeap rely on them).
+            t.Equals(runtime.guestHeapBase(), kGameHeapBase, "reported heap base must be the game's SetupHeap base");
+            t.Equals(runtime.guestHeapLimit(), kGameHeapLimit, "reported heap limit must be the game's SetupHeap limit");
+
+            // The stub scratch allocator (guestMalloc) must never hand out memory inside the
+            // game's heap: re-seeding it onto the game's heap base made the first host-side
+            // stub allocation land exactly on the game's earliest allocations and clobber live
+            // structures (The Warriors wall #2').
+            const uint32_t first = runtime.guestMalloc(128u, 16u);
+            t.IsTrue(first != 0u, "guestMalloc must succeed");
+            t.IsTrue(first < kGameHeapBase, "first scratch allocation must stay below the game's heap base");
+            t.IsTrue(first + 128u <= kGameHeapBase, "first scratch allocation must not reach into the game's heap");
+
+            const uint32_t second = runtime.guestMalloc(128u, 16u);
+            t.IsTrue(second != 0u, "second guestMalloc must succeed");
+            t.IsTrue(second != first, "second scratch allocation must differ from the first");
+            t.IsTrue(second < kGameHeapBase, "second scratch allocation must stay below the game's heap base");
+        });
+
+        tc.Run("repeat configureGuestHeap never re-seeds a live scratch arena", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            runtime.configureGuestHeap(kGameHeapBase, kGameHeapLimit);
+
+            const uint32_t first = runtime.guestMalloc(64u, 16u);
+            t.IsTrue(first != 0u, "guestMalloc must succeed");
+
+            // A repeated SetupHeap configure call must not clear the block list and hand the
+            // same address out again while it may still be referenced.
+            runtime.configureGuestHeap(kGameHeapBase, kGameHeapLimit);
+            const uint32_t second = runtime.guestMalloc(64u, 16u);
+            t.IsTrue(second != 0u, "guestMalloc after repeat configure must succeed");
+            t.IsTrue(second != first, "repeat configure must not reuse a live allocation's address");
+        });
+
+        tc.Run("no-gap heap base falls back to the kernel-space scratch slice", [](TestCase &t)
+        {
+            // Geometry of a game whose heap base sits directly after its static data (no gap
+            // between the post-ELF suggestion and the reported base): the scratch arena must
+            // fall back to kernel space instead of landing on the game's heap.
+            PS2Runtime runtime;
+            runtime.configureGuestHeap(0x00100000u, kGameHeapLimit);
+
+            t.Equals(runtime.guestHeapBase(), 0x00100000u, "reported heap base must stay the game's");
+            t.Equals(runtime.guestHeapLimit(), kGameHeapLimit, "reported heap limit must stay the game's");
+
+            const uint32_t addr = runtime.guestMalloc(128u, 16u);
+            t.IsTrue(addr != 0u, "guestMalloc must succeed");
+            t.IsTrue(addr >= 0x00080000u && addr < 0x00100000u,
+                     "scratch allocation must land in the low kernel slice, not on the game's heap");
+        });
+    });
+}
