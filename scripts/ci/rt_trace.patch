+void EeScheduler::rtTraceDiagnostics()
+{
+    if (!rt_trace_active())
+    {
+        return;
+    }
+    std::string out;
+    char line[512];
+    out += "==== threads ====\n";
+    for (const auto &entry : m_threads)
+    {
+        const GuestThread &t = entry.second;
+        const R5900Context &c = t.activeContext();
+        const char *reason = "None";
+        switch (t.wait.reason)
+        {
+        case EeWaitReason::Sleep: reason = "Sleep"; break;
+        case EeWaitReason::Semaphore: reason = "Sema"; break;
+        case EeWaitReason::EventFlag: reason = "Evf"; break;
+        case EeWaitReason::VSync: reason = "VSync"; break;
+        case EeWaitReason::External: reason = "Ext"; break;
+        case EeWaitReason::Mpeg: reason = "Mpeg"; break;
+        default: break;
+        }
+        int waitId = -1;
+        uint32_t waitType = 0;
+        uint64_t waitToken = 0;
+        if (const auto *sw = std::get_if<EeSemaphoreWait>(&t.wait.payload))
+        {
+            waitId = sw->id;
+        }
+        else if (const auto *ew = std::get_if<EeEventFlagWait>(&t.wait.payload))
+        {
+            waitId = ew->id;
+        }
+        else if (const auto *xw = std::get_if<EeExternalWait>(&t.wait.payload))
+        {
+            waitType = xw->type;
+            waitToken = xw->token;
+        }
+        std::snprintf(line,
+                      sizeof(line),
+                      "t#%d st=%d prio=%d reason=%s wid=%d wtype=0x%x wtok=0x%llx pc=0x%08x ra=0x%08x sp=0x%08x entry=0x%08x\n",
+                      t.id,
+                      static_cast<int>(t.status),
+                      t.currentPriority,
+                      reason,
+                      waitId,
+                      waitType,
+                      static_cast<unsigned long long>(waitToken),
+                      static_cast<uint32_t>(c.pc),
+                      static_cast<uint32_t>(getRegU32(&c, 31)),
+                      static_cast<uint32_t>(getRegU32(&c, 29)),
+                      t.entry);
+        out += line;
+    }
+    out += "==== globals ====\n";
+    {
+        auto rd = [this](uint32_t addr) -> uint32_t {
+            return static_cast<uint32_t>(m_rdram[addr & PS2_RAM_MASK]) |
+                   (static_cast<uint32_t>(m_rdram[(addr + 1u) & PS2_RAM_MASK]) << 8) |
+                   (static_cast<uint32_t>(m_rdram[(addr + 2u) & PS2_RAM_MASK]) << 16) |
+                   (static_cast<uint32_t>(m_rdram[(addr + 3u) & PS2_RAM_MASK]) << 24);
+        };
+        const uint32_t eventObj = rd(0x50AA84u);
+        std::snprintf(line,
+                      sizeof(line),
+                      "event-obj[0x50AA84]=0x%08x obj=0x%08x,%08x,%08x,%08x\n",
+                      eventObj,
+                      eventObj ? rd(eventObj) : 0u,
+                      eventObj ? rd(eventObj + 4u) : 0u,
+                      eventObj ? rd(eventObj + 8u) : 0u,
+                      eventObj ? rd(eventObj + 12u) : 0u);
+        out += line;
+        std::snprintf(line,
+                      sizeof(line),
+                      "sound: bd30=0x%08x c540=0x%08x c548=0x%08x c54c=0x%08x c50c=0x%08x c554=0x%08x c558=0x%08x c55c=0x%08x\n",
+                      rd(0x50BD30u),
+                      rd(0x50C540u),
+                      rd(0x50C548u),
+                      rd(0x50C54Cu),
+                      rd(0x50C50Cu),
+                      rd(0x50C554u),
+                      rd(0x50C558u),
+                      rd(0x50C55Cu));
+        out += line;
+    }
+    out += "==== iop ====\n";
+    if (auto *iop = m_runtime.iopSubsystem())
+    {
+        const ps2x::iop::DebugSnapshot snap = iop->debugSnapshot();
+        std::snprintf(line,
+                      sizeof(line),
+                      "iop cycles=%llu insns=%llu modules=%u threads=%u servers=%u\n",
+                      static_cast<unsigned long long>(snap.emulatorCycles),
+                      static_cast<unsigned long long>(snap.emulatorInstructions),
+                      snap.emulatorLoadedModules,
+                      snap.emulatorThreads,
+                      snap.emulatorRpcServers);
+        out += line;
+        out += iop->debugThreadDump();
+    }
+    out += "==== rpc ring (last 40) ====\n";
+    {
+        char rpcBuf[8192];
+        const size_t written = rtTraceRpcDesc(rpcBuf, sizeof(rpcBuf), 40u);
+        if (written > 0u)
