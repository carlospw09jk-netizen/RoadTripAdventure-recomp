+// ---------------------------------------------------------------- RT_TRACE
+// Lightweight execution trace for boot triage: with RT_TRACE=1 the last few
+// thousand inter-function transfers and kernel syscalls are kept in ring
+// buffers and dumped to stderr when a thread dies. Diagnostic-only, .cpp-side
+// so the on-device build kit (and its build id) is untouched.
+namespace rt_trace
+{
+    static bool enabled()
+    {
+        static const bool on = []
+        {
+            const char *e = std::getenv("RT_TRACE");
+            return e && *e && *e != '0';
+        }();
+        return on;
+    }
+
+    struct BranchEntry
+    {
+        uint32_t kind, source, target, ra, a0, a1, a2, a3;
+    };
+    struct SysEntry
+    {
+        uint32_t number, pc, ra, a0, a1, v0;
+    };
+    struct PcEntry
+    {
+        uint32_t pc, ra, sp;
+    };
+
+    static constexpr uint64_t kBranchCap = 4096;
+    static constexpr uint64_t kSysCap = 1024;
+    static BranchEntry g_branches[kBranchCap];
+    static SysEntry g_syscalls[kSysCap];
+    static constexpr uint64_t kPcCap = 32768;
+    static PcEntry g_pcs[kPcCap];
+    static std::atomic<uint64_t> g_branchCount{0};
+    static std::atomic<uint64_t> g_sysCount{0};
+    static std::atomic<uint64_t> g_pcCount{0};
+    static std::atomic<bool> g_dumped{false};
+
+    static inline uint32_t reg(const R5900Context *ctx, int i)
+    {
+        return static_cast<uint32_t>(_mm_extract_epi32(ctx->r[i], 0));
+    }
+
+    static void checkWatches(uint8_t *rdram, const R5900Context *ctx, uint64_t pcIndex);
+    static void writeTraceText(const std::string &text);
+
+    static void pushBranch(uint8_t *rdram, uint32_t kind, uint32_t source, uint32_t target, const R5900Context *ctx)
+    {
+        if (!enabled())
+            return;
+        checkWatches(rdram, ctx, g_branchCount.load(std::memory_order_relaxed));
+        const uint64_t i = g_branchCount.fetch_add(1, std::memory_order_relaxed);
+        BranchEntry &e = g_branches[i % kBranchCap];
+        e.kind = kind;
+        e.source = source;
+        e.target = target;
+        e.ra = reg(ctx, 31);
+        e.a0 = reg(ctx, 4);
+        e.a1 = reg(ctx, 5);
+        e.a2 = reg(ctx, 6);
+        e.a3 = reg(ctx, 7);
+    }
+
+    static int64_t pushSys(uint32_t number, const R5900Context *ctx)
+    {
+        if (!enabled())
+            return -1;
+        const uint64_t i = g_sysCount.fetch_add(1, std::memory_order_relaxed);
+        SysEntry &e = g_syscalls[i % kSysCap];
+        e.number = number;
+        e.pc = ctx->pc;
+        e.ra = reg(ctx, 31);
+        e.a0 = reg(ctx, 4);
+        e.a1 = reg(ctx, 5);
+        e.v0 = 0;
+        return static_cast<int64_t>(i);
+    }
+
+    static void finishSys(int64_t slot, const R5900Context *ctx)
+    {
+        if (slot < 0 || !enabled())
+            return;
+        g_syscalls[static_cast<uint64_t>(slot) % kSysCap].v0 = reg(ctx, 2);
+    }
+
+    struct WatchSlot
+    {
+        uint32_t addr;
+        uint32_t last;
+        bool init;
+    };
+    static WatchSlot g_watch[8] = {
+        {0x1FFFF40u, 0, false}, {0x1FFFF44u, 0, false}, {0x1FFFF3Cu, 0, false}, {0x1FFFF00u, 0, false},
+        {0x1FFFF30u, 0, false}, {0x1FFFF50u, 0, false}, {0x1FFFF70u, 0, false}, {0x1FFFFB0u, 0, false},
+    };
+
+    static uint32_t rd32(uint8_t *rdram, uint32_t addr)
+    {
+        uint32_t v = 0;
+        if (rdram && addr <= 0x02000000u - 4u)
+            std::memcpy(&v, rdram + addr, 4);
+        return v;
+    }
+
+    static void checkWatches(uint8_t *rdram, const R5900Context *ctx, uint64_t pcIndex)
+    {
+        if (!enabled() || !rdram)
+            return;
+        for (auto &w : g_watch)
+        {
+            const uint32_t now = rd32(rdram, w.addr);
+            if (!w.init)
+            {
+                w.last = now;
+                w.init = true;
+                continue;
+            }
+            if (now != w.last)
+            {
+                std::ostringstream oss;
+                oss << "[trace:watch] #" << pcIndex << " pc=0x" << std::hex << ctx->pc << " addr=0x" << w.addr
+                    << " old=0x" << w.last << " new=0x" << now << " ra=0x" << reg(ctx, 31) << " sp=0x" << reg(ctx, 29)
+                    << std::dec << "\n";
+                writeTraceText(oss.str());
+                w.last = now;
+            }
+        }
+    }
+
+    static void writeTraceText(const std::string &text)
+    {
+        std::cerr << text << std::flush;
+        const char *path = std::getenv("RT_TRACE_FILE");
+        if (path && *path)
+        {
+            std::ofstream f(path, std::ios::app | std::ios::binary);
+            if (f)
+                f << text;
+        }
+    }
+
+    static void pushPc(uint8_t *rdram, const R5900Context *ctx)
+    {
+        if (!enabled())
+            return;
+        const uint64_t i = g_pcCount.fetch_add(1, std::memory_order_relaxed);
+        PcEntry &e = g_pcs[i % kPcCap];
+        e.pc = ctx->pc;
+        e.ra = reg(ctx, 31);
+        e.sp = reg(ctx, 29);
+        checkWatches(rdram, ctx, i);
+    }
+
+    static void deathNote(uint8_t *rdram, const R5900Context *ctx)
+    {
+        if (!enabled())
+            return;
+        std::ostringstream oss;
+        static const char *names[32] = {"r0", "at", "v0", "v1", "a0", "a1", "a2", "a3", "t0", "t1", "t2", "t3",
+                                        "t4", "t5", "t6", "t7", "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7",
+                                        "t8", "t9", "k0", "k1", "gp", "sp", "fp", "ra"};
+        oss << "[trace] ==== DEATH (thread retired, pc=0) ====\n";
+        for (int r = 0; r < 32; ++r)
+            oss << "[trace:death] " << names[r] << "=0x" << std::hex << reg(ctx, r) << std::dec << "\n";
+        const uint32_t sp = reg(ctx, 29);
+        if (rdram && sp <= 0x02000000u - 128u)
+            for (uint32_t off = 0; off < 128u; off += 4u)
+            {
+                uint32_t w = 0;
+                std::memcpy(&w, rdram + sp + off, 4);
+                oss << "[trace:death] [sp+0x" << std::hex << off << "]=0x" << w << std::dec << "\n";
+            }
+        writeTraceText(oss.str());
+    }
+
+    static void dump()
+    {
+        if (!enabled() || g_dumped.exchange(true))
+            return;
+        const uint64_t bc = g_branchCount.load(std::memory_order_relaxed);
+        const uint64_t sc = g_sysCount.load(std::memory_order_relaxed);
+        std::ostringstream oss;
+        const uint64_t s0 = sc > kSysCap ? sc - kSysCap : 0;
+        oss << "[trace] ==== syscalls " << s0 << ".." << sc << " ====\n";
+        for (uint64_t i = s0; i < sc; ++i)
+        {
+            const SysEntry &e = g_syscalls[i % kSysCap];
+            oss << "[trace:sys] #" << i << " n=0x" << std::hex << e.number << " pc=0x" << e.pc
+                << " ra=0x" << e.ra << " a0=0x" << e.a0 << " a1=0x" << e.a1
+                << " -> v0=0x" << e.v0 << std::dec << "\n";
+        }
+        const uint64_t b0 = bc > kBranchCap ? bc - kBranchCap : 0;
+        oss << "[trace] ==== branches " << b0 << ".." << bc << " ====\n";
+        for (uint64_t i = b0; i < bc; ++i)
+        {
+            const BranchEntry &e = g_branches[i % kBranchCap];
+            oss << "[trace:br] #" << i << " k=" << e.kind << " 0x" << std::hex << e.source << "->0x" << e.target
+                << " ra=0x" << e.ra << " a0=0x" << e.a0 << " a1=0x" << e.a1
+                << " a2=0x" << e.a2 << " a3=0x" << e.a3 << std::dec << "\n";
+        }
+        const uint64_t pcc = g_pcCount.load(std::memory_order_relaxed);
+        const uint64_t p0 = pcc > kPcCap ? pcc - kPcCap : 0;
+        oss << "[trace] ==== dispatch pcs " << p0 << ".." << pcc << " ====\n";
+        for (uint64_t i = p0; i < pcc; ++i)
+        {
+            const PcEntry &e = g_pcs[i % kPcCap];
+            oss << "[trace:pc] #" << i << " pc=0x" << std::hex << e.pc << " ra=0x" << e.ra << " sp=0x" << e.sp
+                << std::dec << "\n";
+        }
+        writeTraceText(oss.str());
+    }
+} // namespace rt_trace
+
+extern "C" void rt_trace_dump()
+{
+    rt_trace::dump();
+}
+
+extern "C" int rt_trace_active()
+{
+    return rt_trace::enabled() ? 1 : 0;
+}
+
+extern "C" void rt_trace_push_pc(uint8_t *rdram, const R5900Context *ctx)
+{
+    rt_trace::pushPc(rdram, ctx);
+}
+
+extern "C" void rt_trace_death(uint8_t *rdram, const R5900Context *ctx)
+{
+    rt_trace::deathNote(rdram, ctx);
+}
+
