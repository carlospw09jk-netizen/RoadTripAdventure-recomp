+// Trace helper: serialize the recent SIF RPC debug-ring into a text buffer.
+// Lives here because the ring and its event type are private to this TU.
+extern "C" size_t rtTraceRpcDesc(char *out, size_t cap, size_t limit)
+{
+    if (out == nullptr || cap == 0u)
+    {
+        return 0u;
+    }
+    uint64_t maxSeq = 0u;
+    for (size_t i = 0; i < kSifRpcDebugHistoryCount; ++i)
+    {
+        if (g_sif_rpc_debug_history[i].seq > maxSeq)
+        {
+            maxSeq = g_sif_rpc_debug_history[i].seq;
+        }
+    }
+    if (maxSeq == 0u)
+    {
+        return 0u;
+    }
+    size_t used = 0u;
+    const size_t count = std::min<size_t>(limit, static_cast<size_t>(maxSeq));
+    const size_t begin = static_cast<size_t>(maxSeq) + 1u - count;
+    for (size_t seq = begin; seq <= static_cast<size_t>(maxSeq); ++seq)
+    {
+        const SifRpcDebugEvent &e = g_sif_rpc_debug_history[seq % kSifRpcDebugHistoryCount];
+        if (e.seq == 0u)
+        {
+            continue;
+        }
+        char line[640];
+        char sendHex[40];
+        char recvHex[40];
+        for (size_t b = 0; b < 16u; b += 4u)
+        {
+            std::snprintf(sendHex + b * 2u, 9u, "%02x%02x%02x%02x", e.sendPreview[b], e.sendPreview[b + 1u], e.sendPreview[b + 2u], e.sendPreview[b + 3u]);
+            std::snprintf(recvHex + b * 2u, 9u, "%02x%02x%02x%02x", e.recvPreview[b], e.recvPreview[b + 1u], e.recvPreview[b + 2u], e.recvPreview[b + 3u]);
+        }
+        const int n = std::snprintf(line,
+                                    sizeof(line),
+                                    "rpc#%llu %s sid=0x%08x fn=0x%x fl=0x%x res=%d pc=0x%08x snd=%u rcv=%u sp=[%s] rp=[%s]\n",
+                                    static_cast<unsigned long long>(e.seq),
+                                    e.op != nullptr ? e.op : "?",
+                                    e.sid,
+                                    e.rpcNum,
+                                    e.flags,
+                                    e.result,
+                                    e.pc,
+                                    e.sendSize,
+                                    e.recvSize,
+                                    sendHex,
+                                    recvHex);
+        if (n <= 0)
+        {
+            continue;
+        }
+        const size_t len = std::min<size_t>(static_cast<size_t>(n), sizeof(line) - 1u);
+        if (used + len > cap)
+        {
+            break;
+        }
+        std::memcpy(out + used, line, len);
+        used += len;
+    }
+    return used;
+}
