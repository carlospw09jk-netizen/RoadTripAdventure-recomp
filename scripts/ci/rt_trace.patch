+    out += "==== semaphores ====\n";
+    for (const auto &entry : m_semaphores)
+    {
+        const EeSemaphore &s = entry.second;
+        std::snprintf(line,
+                      sizeof(line),
+                      "sema#%d count=%d max=%d init=%d waiters=%zu\n",
+                      s.id,
+                      s.count,
+                      s.maxCount,
+                      s.initCount,
+                      s.waiters.size());
+        out += line;
+    }
+    out += "==== eventflags ====\n";
+    for (const auto &entry : m_eventFlags)
