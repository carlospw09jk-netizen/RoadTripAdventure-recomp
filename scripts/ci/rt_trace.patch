+// ---------------------------------------------------------------- RT_TRACE
+// Lightweight execution trace for boot triage: with RT_TRACE=1 the last few
+// thousand inter-function transfers and kernel syscalls are kept in ring
+// buffers and dumped to stderr when a thread dies. Diagnostic-only, .cpp-side
+// so the on-device build kit (and its build id) is untouched.
+namespace rt_trace
+{
+    static bool enabled()
+    {
+        static const bool on = []
+        {
+            const char *e = std::getenv("RT_TRACE");
+            return e && *e && *e != '0';
+        }();
+        return on;
+    }
+
+    struct BranchEntry
+    {
+        uint32_t kind, source, target, ra, a0, a1, a2, a3;
+    };
+    struct SysEntry
+    {
+        uint32_t number, pc, ra, a0, a1, v0;
+    };
+    struct PcEntry
+    {
+        uint32_t pc, ra, sp;
+    };
+
+    static constexpr uint64_t kBranchCap = 4096;
+    static constexpr uint64_t kSysCap = 1024;
+    static BranchEntry g_branches[kBranchCap];
+    static SysEntry g_syscalls[kSysCap];
+    static constexpr uint64_t kPcCap = 32768;
+    static PcEntry g_pcs[kPcCap];
+    static std::atomic<uint64_t> g_branchCount{0};
+    static std::atomic<uint64_t> g_sysCount{0};
+    static std::atomic<uint64_t> g_pcCount{0};
+    static std::atomic<bool> g_dumped{false};
+
+    static inline uint32_t reg(const R5900Context *ctx, int i)
+    {
+        return static_cast<uint32_t>(_mm_extract_epi32(ctx->r[i], 0));
+    }
+
+    static void checkWatches(uint8_t *rdram, const R5900Context *ctx, uint64_t pcIndex);
+    static void writeTraceText(const std::string &text);
+    static uint32_t rd32(uint8_t *rdram, uint32_t addr);
+
+    static void probe(uint8_t *rdram, uint32_t src, const R5900Context *ctx)
+    {
+        if (src != 0x14BC60u && src != 0x339A44u && src != 0x1929F0u)
+            return;
+        const uint32_t r2 = reg(ctx, 2), r3 = reg(ctx, 3), r4 = reg(ctx, 4), r12 = reg(ctx, 12), ra = reg(ctx, 31);
+        std::ostringstream oss;
+        oss << "[trace:probe] src=0x" << std::hex << src << " method/entry=0x" << r2 << " r3=0x" << r3
+            << " r4=0x" << r4 << " r12=0x" << r12 << " ra=0x" << ra << " m6eb9d0=0x" << rd32(rdram, 0x6EB9D0u)
+            << " m760c10=0x" << rd32(rdram, 0x760C10u) << " m760c20=0x" << rd32(rdram, 0x760C20u);
+        if (r12 >= 8u && r12 <= 0x01FFFFFCu)
+            oss << " m[r12]=0x" << rd32(rdram, r12);
+        if (r3 >= 8u && r3 <= 0x01FFFFFCu)
+            oss << " m[r3+50]=0x" << rd32(rdram, r3 + 0x50u) << " m[r3+54]=0x" << rd32(rdram, r3 + 0x54u);
+        oss << std::dec << "\n";
+        writeTraceText(oss.str());
+    }
+
+    // --- K11 directed capture: wrap suspect guest functions; log watch diffs at enter/exit ---
+    struct WrapSlot
+    {
+        uint32_t addr;
+        PS2Runtime::RecompiledFunction orig;
+    };
+    static WrapSlot g_wraps[28];
+    static int g_wrapCount = 0;
+    static const uint32_t kWatchNow[8] = {0x715B60u, 0x715B70u, 0x715B74u, 0x715B78u, 0x715B80u, 0x715B90u, 0x6EB978u, 0x6EB970u};
+    static uint32_t g_watchNowLast[8] = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u};
+    static bool g_watchNowInit = false;
+
+    static void checkNow(uint8_t *rdram, const R5900Context *ctx, const char *tag, uint32_t fnAddr)
+    {
+        if (!enabled() || !rdram)
+            return;
+        for (int i = 0; i < 8; ++i)
+        {
+            const uint32_t now = rd32(rdram, kWatchNow[i]);
+            if (!g_watchNowInit)
+            {
+                g_watchNowLast[i] = now;
+                continue;
+            }
+            if (now != g_watchNowLast[i])
+            {
+                std::ostringstream oss;
+                oss << "[trace:wrapwatch] " << tag << " fn=0x" << std::hex << fnAddr
+                    << " pc=0x" << ctx->pc << " addr=0x" << kWatchNow[i] << " old=0x" << g_watchNowLast[i]
+                    << " new=0x" << now << " ra=0x" << reg(ctx, 31) << " sp=0x" << reg(ctx, 29)
+                    << std::dec << "\n";
+                writeTraceText(oss.str());
+                g_watchNowLast[i] = now;
+            }
+        }
+        g_watchNowInit = true;
+    }
+
+    static void wrapTramp(uint8_t *rdram, R5900Context *ctx, PS2Runtime *rt)
+    {
+        const uint32_t addr = ctx->pc;
+        checkNow(rdram, ctx, "enter", addr);
+        for (int i = 0; i < g_wrapCount; ++i)
+        {
+            if (g_wraps[i].addr == addr)
+            {
+                g_wraps[i].orig(rdram, ctx, rt);
+                break;
+            }
+        }
+        checkNow(rdram, ctx, "exit", addr);
+    }
+
+    static void installWraps(PS2Runtime &rt)
+    {
+        if (!enabled())
+            return;
+        static const uint32_t kSuspects[24] = {
+            0x496A50u, 0x496400u, 0x4AA180u, 0x4AA310u, 0x4AB720u, 0x4A3600u,
+            0x4A9F28u, 0x4AA9F0u, 0x192908u, 0x339A20u, 0x338BF0u, 0x338528u,
+            0x43D3E0u, 0x43DAD8u, 0x43CDA0u, 0x43CCA0u, 0x43D910u, 0x47BFC8u,
+            0x47C090u, 0x497730u, 0x483750u, 0x194A68u, 0x483218u, 0x194618u,
+        };
+        std::ostringstream rep;
+        rep << "[trace:wrap] installing suspects\n";
+        for (uint32_t a : kSuspects)
+        {
+            if (g_wrapCount >= 28)
+                break;
+            PS2Runtime::RecompiledFunction orig = rt.lookupFunction(a);
+            if (!orig)
+            {
+                rep << "[trace:wrap] skip 0x" << std::hex << a << " (no fn)\n";
+                continue;
+            }
+            g_wraps[g_wrapCount].addr = a;
+            g_wraps[g_wrapCount].orig = orig;
+            ++g_wrapCount;
+            rt.replaceFunction(a, &wrapTramp);
+            rep << "[trace:wrap] wrapped 0x" << std::hex << a << "\n";
+        }
+        rep << std::dec;
+        writeTraceText(rep.str());
+    }
+
+    static void pushBranch(uint8_t *rdram, uint32_t kind, uint32_t source, uint32_t target, const R5900Context *ctx)
+    {
+        if (!enabled())
+            return;
+        probe(rdram, source, ctx);
+        checkWatches(rdram, ctx, g_branchCount.load(std::memory_order_relaxed));
+        const uint64_t i = g_branchCount.fetch_add(1, std::memory_order_relaxed);
+        BranchEntry &e = g_branches[i % kBranchCap];
+        e.kind = kind;
+        e.source = source;
+        e.target = target;
+        e.ra = reg(ctx, 31);
+        e.a0 = reg(ctx, 4);
+        e.a1 = reg(ctx, 5);
+        e.a2 = reg(ctx, 6);
+        e.a3 = reg(ctx, 7);
+    }
+
+    static int64_t pushSys(uint32_t number, const R5900Context *ctx)
+    {
+        if (!enabled())
+            return -1;
+        const uint64_t i = g_sysCount.fetch_add(1, std::memory_order_relaxed);
+        SysEntry &e = g_syscalls[i % kSysCap];
+        e.number = number;
+        e.pc = ctx->pc;
+        e.ra = reg(ctx, 31);
+        e.a0 = reg(ctx, 4);
+        e.a1 = reg(ctx, 5);
+        e.v0 = 0;
+        return static_cast<int64_t>(i);
+    }
+
+    static void finishSys(int64_t slot, const R5900Context *ctx)
+    {
+        if (slot < 0 || !enabled())
+            return;
+        g_syscalls[static_cast<uint64_t>(slot) % kSysCap].v0 = reg(ctx, 2);
+    }
+
+    struct WatchSlot
+    {
+        uint32_t addr;
+        uint32_t last;
+        bool init;
+    };
+    static WatchSlot g_watch[28] = {
+        {0x1FFFF40u, 0, false}, {0x1FFFF44u, 0, false}, {0x1FFFF3Cu, 0, false}, {0x1FFFF00u, 0, false},
+        {0x1FFFF30u, 0, false}, {0x1FFFF50u, 0, false}, {0x1FFFF70u, 0, false}, {0x1FFFFB0u, 0, false},
+        {0x760C00u, 0, false}, {0x760C10u, 0, false}, {0x760C20u, 0, false}, {0x760C30u, 0, false},
+        {0x760C40u, 0, false}, {0x760C50u, 0, false}, {0x760C60u, 0, false}, {0x6EB9D0u, 0, false},
+        {0x6EB970u, 0, false}, {0x715C98u, 0, false},
+        {0x715B60u, 0, false}, {0x715B70u, 0, false}, {0x715B74u, 0, false}, {0x715B78u, 0, false},
+        {0x715B80u, 0, false}, {0x715B90u, 0, false}, {0x715BF0u, 0, false}, {0x6EB978u, 0, false},
+        {0x6EB97Cu, 0, false}, {0x6EB960u, 0, false},
+    };
+
+    static uint32_t rd32(uint8_t *rdram, uint32_t addr)
+    {
+        uint32_t v = 0;
+        if (rdram && addr <= 0x02000000u - 4u)
+            std::memcpy(&v, rdram + addr, 4);
+        return v;
+    }
+
+    static void checkWatches(uint8_t *rdram, const R5900Context *ctx, uint64_t pcIndex)
+    {
+        if (!enabled() || !rdram)
+            return;
+        for (auto &w : g_watch)
+        {
+            const uint32_t now = rd32(rdram, w.addr);
+            if (!w.init)
+            {
+                w.last = now;
+                w.init = true;
+                continue;
+            }
+            if (now != w.last)
+            {
+                std::ostringstream oss;
+                oss << "[trace:watch] #" << pcIndex << " pc=0x" << std::hex << ctx->pc << " addr=0x" << w.addr
+                    << " old=0x" << w.last << " new=0x" << now << " ra=0x" << reg(ctx, 31) << " sp=0x" << reg(ctx, 29);
+                const uint64_t pcCount = g_pcCount.load(std::memory_order_relaxed);
+                if (pcCount > 0)
+                {
+                    oss << " prevpc=";
+                    for (uint64_t k = (pcCount > 6 ? pcCount - 6 : 0); k < pcCount; ++k)
+                        oss << "0x" << g_pcs[k % kPcCap].pc << ",";
+                }
+                oss << std::dec << "\n";
+                writeTraceText(oss.str());
+                w.last = now;
+            }
+        }
+    }
+
+    static void writeTraceText(const std::string &text)
+    {
+        std::cerr << text << std::flush;
+        const char *path = std::getenv("RT_TRACE_FILE");
+        if (path && *path)
+        {
+            std::ofstream f(path, std::ios::app | std::ios::binary);
+            if (f)
+                f << text;
+        }
+    }
+
+    static void pushPc(uint8_t *rdram, const R5900Context *ctx)
+    {
+        if (!enabled())
+            return;
+        const uint64_t i = g_pcCount.fetch_add(1, std::memory_order_relaxed);
+        PcEntry &e = g_pcs[i % kPcCap];
+        e.pc = ctx->pc;
+        e.ra = reg(ctx, 31);
+        e.sp = reg(ctx, 29);
+        checkWatches(rdram, ctx, i);
+    }
+
+    static void deathNote(uint8_t *rdram, const R5900Context *ctx)
+    {
+        if (!enabled())
+            return;
+        std::ostringstream oss;
+        static const char *names[32] = {"r0", "at", "v0", "v1", "a0", "a1", "a2", "a3", "t0", "t1", "t2", "t3",
+                                        "t4", "t5", "t6", "t7", "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7",
+                                        "t8", "t9", "k0", "k1", "gp", "sp", "fp", "ra"};
+        oss << "[trace] ==== DEATH (thread retired, pc=0) ====\n";
+        for (int r = 0; r < 32; ++r)
+            oss << "[trace:death] " << names[r] << "=0x" << std::hex << reg(ctx, r) << std::dec << "\n";
+        const uint32_t sp = reg(ctx, 29);
+        if (rdram && sp <= 0x02000000u - 128u)
+            for (uint32_t off = 0; off < 128u; off += 4u)
+            {
+                uint32_t w = 0;
+                std::memcpy(&w, rdram + sp + off, 4);
+                oss << "[trace:death] [sp+0x" << std::hex << off << "]=0x" << w << std::dec << "\n";
+            }
+        writeTraceText(oss.str());
+    }
+
+    static void dump()
+    {
+        if (!enabled())
+            return;
+        static std::atomic<uint64_t> g_lastDumpBranch{0};
+        const uint64_t bcNow = g_branchCount.load(std::memory_order_relaxed);
+        const uint64_t prevDump = g_lastDumpBranch.load(std::memory_order_relaxed);
+        if (g_dumped.exchange(true) && bcNow < prevDump + 1024u)
+            return; // already dumped, and no meaningful new activity since
+        g_lastDumpBranch.store(bcNow, std::memory_order_relaxed);
+        const uint64_t bc = bcNow;
+        const uint64_t sc = g_sysCount.load(std::memory_order_relaxed);
+        std::ostringstream oss;
+        const uint64_t s0 = sc > kSysCap ? sc - kSysCap : 0;
+        oss << "[trace] ==== syscalls " << s0 << ".." << sc << " ====\n";
+        for (uint64_t i = s0; i < sc; ++i)
+        {
+            const SysEntry &e = g_syscalls[i % kSysCap];
+            oss << "[trace:sys] #" << i << " n=0x" << std::hex << e.number << " pc=0x" << e.pc
+                << " ra=0x" << e.ra << " a0=0x" << e.a0 << " a1=0x" << e.a1
+                << " -> v0=0x" << e.v0 << std::dec << "\n";
+        }
+        const uint64_t b0 = bc > kBranchCap ? bc - kBranchCap : 0;
+        oss << "[trace] ==== branches " << b0 << ".." << bc << " ====\n";
+        for (uint64_t i = b0; i < bc; ++i)
+        {
+            const BranchEntry &e = g_branches[i % kBranchCap];
+            oss << "[trace:br] #" << i << " k=" << e.kind << " 0x" << std::hex << e.source << "->0x" << e.target
+                << " ra=0x" << e.ra << " a0=0x" << e.a0 << " a1=0x" << e.a1
+                << " a2=0x" << e.a2 << " a3=0x" << e.a3 << std::dec << "\n";
+        }
+        const uint64_t pcc = g_pcCount.load(std::memory_order_relaxed);
+        const uint64_t p0 = pcc > kPcCap ? pcc - kPcCap : 0;
+        oss << "[trace] ==== dispatch pcs " << p0 << ".." << pcc << " ====\n";
+        for (uint64_t i = p0; i < pcc; ++i)
+        {
+            const PcEntry &e = g_pcs[i % kPcCap];
+            oss << "[trace:pc] #" << i << " pc=0x" << std::hex << e.pc << " ra=0x" << e.ra << " sp=0x" << e.sp
+                << std::dec << "\n";
+        }
+        writeTraceText(oss.str());
+    }
+} // namespace rt_trace
+
+extern "C" void rt_trace_dump()
+{
+    rt_trace::dump();
+}
+
+extern "C" int rt_trace_active()
+{
+    return rt_trace::enabled() ? 1 : 0;
+}
+
+extern "C" void rt_trace_push_pc(uint8_t *rdram, const R5900Context *ctx)
+{
+    rt_trace::pushPc(rdram, ctx);
+}
+
+extern "C" void rt_trace_death(uint8_t *rdram, const R5900Context *ctx)
+{
+    rt_trace::deathNote(rdram, ctx);
+}
